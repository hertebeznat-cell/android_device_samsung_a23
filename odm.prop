# Kept from the stock SEZB1 odm build.prop.
ro.vendor.qti.va_odm.support=1

# Bluetooth profiles. Android 13+ starts a profile only if its
# bluetooth.profile.*.enabled property is true (bluetooth_config_prop, set
# from vendor/odm); the Android 11 stock vendor sets none, so only GATT and
# ASHA ran and phones could neither send files (OPP) nor play to speakers
# (A2DP). Classic profiles only: the 4.19 kernel and BT 5.0 controller have
# no LE Audio.
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true

# Incremental (streaming) installs: the stock vendor sets ro.incremental.enable=1
# for its own One UI kernel. Google Play then installs through incfs, and
# pressing Install rebooted phones on this 4.19 kernel with the Android 17
# installer. Fall back to plain installs (whole APK downloaded first); odm is
# loaded after vendor, so this overrides it.
ro.incremental.enable=0
