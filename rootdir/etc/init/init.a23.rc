on early-boot
    # The stock SEZB1 policy lets the Samsung Codec2 service call mremap only
    # with MREMAP_MAYMOVE|MREMAP_FIXED; Android 17's libc also uses plain
    # MREMAP_MAYMOVE, so the service died with SIGSYS in a loop. It serves
    # IComponentStore/default (the hardware codecs): without it video
    # recording hung and media playback stalled. Overlay a copy that also
    # allows those flags (the vendor image stays untouched).
    mount none /system_ext/etc/seccomp_policy/samsung.software.media.c2-base-policy /vendor/etc/seccomp_policy/samsung.software.media.c2-base-policy bind

on post-fs-data
    # Directories the stock vendor creates under /data, labelled since the
    # One UI labels were ported (sepolicy/private); fix earlier installs.
    restorecon_recursive /data/log
    restorecon_recursive /data/nfc
    restorecon_recursive /data/sec
