#
# Installed to /odm/etc/init so the writes run as vendor_init, which may
# write sysfs; init itself may only read these nodes.
#
# Applied once the stock /vendor/bin/init.qcom.post_boot.sh has finished: it
# rewrites scaling_governor, which resets every schedutil tunable (pl written
# at boot_completed was back to 0), and it zeroes the Qualcomm input boost.

on early-boot
    # GPU floor, 600 MHz (see below). Written before the Qualcomm perf HAL
    # (class hal, started on boot) runs: it manages these nodes and, when its
    # last lock on one is released, restores the value it read when the
    # first lock was taken. Written only after boot, the 600 MHz floor was
    # back at 320 MHz once the boot-time boost ended.
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 3
    write /sys/class/kgsl/kgsl-3d0/default_pwrlevel 3
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 600000000

on property:init.svc.qcom-post-boot=stopped
    # One UI raises CPU/GPU floors through Samsung's Hyper hints on touch and
    # launch; the AOSP framework sends none, and the GPU idled at its 320 MHz
    # floor between frames. Opening the notification shade kept the Adreno
    # 610 72-74 % busy even at 600 MHz (sampled every 50 ms), and frames
    # spent ~18 ms waiting on buffers/GPU, so start it from 600 MHz. It still
    # power-collapses when idle (idle_timer 80 ms), so the floor only costs
    # power while it renders.
    # KGSL clamps its power level to min_pwrlevel; devfreq/min_freq is not
    # honoured by msm-adreno-tz (it read 465 MHz while the GPU ran at 320).
    # Levels: 0 = 1114.8, 1 = 1025, 2 = 785, 3 = 600, 4 = 465, 5 = 320 MHz.
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 3
    write /sys/class/kgsl/kgsl-3d0/default_pwrlevel 3
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 600000000
    # schedutil predicted load, as Qualcomm's post_boot scripts use it: ramp
    # for a task's expected demand instead of waiting for the next window.
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/pl 1
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/pl 1
    # Qualcomm's kernel input boost (cpu_boost), which the stock script turns
    # off for this SoC because One UI boosts from userspace instead: raise the
    # little and big cluster floors to their hispeed frequencies for 120 ms
    # after each touch, so animations start at speed.
    write /sys/devices/system/cpu/cpu_boost/input_boost_freq "0:1516800 4:1344000"
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 120
