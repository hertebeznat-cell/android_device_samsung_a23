# Root mount points of the stock SEZB1 vendor fstab, labelled as One UI does.
# The mounted filesystems carry their own labels. /efs is labelled by
# system/sepolicy.
/carrier(/.*)?          u:object_r:carrier_file:s0
/spu(/.*)?              u:object_r:spu_file:s0
/prism(/.*)?            u:object_r:system_file:s0
/prism/etc/carriers(/.*)?  u:object_r:vendor_configs_file:s0
/optics(/.*)?           u:object_r:vendor_file:s0
/optics/configs(/.*)?   u:object_r:vendor_configs_file:s0

# Overlay for the stock Samsung Codec2 seccomp policy (init.a23.rc). Every
# domain may read system_seccomp_policy_file, including vendor mediacodec.
/(system_ext|system/system_ext)/etc/seccomp_policy/samsung\.software\.media\.c2-base-policy  u:object_r:system_seccomp_policy_file:s0

# --- Generated by tools/port_stock_sepolicy.py below this line ---
/dev/ion                                 u:object_r:ion_device:s0
/dev/socket/mtpd                         u:object_r:mtpd_socket:s0
/dev/socket/racoon                       u:object_r:racoon_socket:s0
/dev/\.pa(/.*)?                          u:object_r:pa_daemon_device:s0
/data/log(/.*)?                          u:object_r:dumplog_data_file:s0
/data/sec(/.*)?                          u:object_r:sec_data_file:s0
/data/nfc(/.*)?                          u:object_r:nfc_data_file:s0
/data/misc/speg(/.*)?                    u:object_r:speg_marker_data_file:s0
/data/misc/elabel(/.*)?                  u:object_r:vendor_elabel_data_file:s0
/dev/\.secure_storage(/.*)?              u:object_r:secure_storage_device:s0
/data/sec_maintenance(/.*)?              u:object_r:sec_data_file:s0
/dev/socket/tcm                          u:object_r:vendor_dpmtcm_socket:s0
/dev/socket/tcmd                         u:object_r:vendor_dpmtcm_socket:s0
/dev/task_integrity                      u:object_r:system_integrity_device:s0
/dev/socket/seempdw                      u:object_r:vendor_seempdw_socket:s0
