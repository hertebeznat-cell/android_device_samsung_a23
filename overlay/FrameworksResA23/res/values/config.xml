<resources>
    <!-- Display -->
    <bool name="config_showNavigationBar">true</bool>
    <!-- 90 Hz stays available (Settings > Display > Smooth display), but with the
         Android 11 display/GPU stack SurfaceFlinger misses most 11 ms deadlines:
         SystemUI janked 97% of frames at 90 Hz against 11% at 60 Hz. -->
    <integer name="config_defaultPeakRefreshRate">60</integer>
    <integer name="config_defaultRefreshRate">60</integer>

    <!-- Waterdrop notch -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,0 H -30.57777777777778 V 23.11111111111111 H 30.57777777777778 V 0 H 0 Z @dp</string>
    <!-- Filling drew a black bar across the whole cutout rectangle. -->
    <bool name="config_fillMainBuiltInDisplayCutout">false</bool>
    <!-- No rounded_corner_radius_top/bottom: with a radius, SystemUI keeps two
         full-width ScreenDecorOverlay layers on screen at all times to mask the
         corners, which the panel already rounds. The SM6225 HWC has few pipes,
         so with those two layers any animation (app launch, notification shade)
         sent the whole frame to GPU composition; SurfaceFlinger then missed
         ~600 GPU frames in a minute and SystemUI's median frame was 46 ms.
         Without a radius the overlays only show with the privacy dot. -->
    <dimen name="status_bar_height_portrait">4.389984mm</dimen>

    <!-- Brightness -->
    <integer name="config_screenBrightnessDim">7</integer>
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">128</integer>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.02745098</item>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.003921569</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.5019608</item>

    <bool name="config_automatic_brightness_available">true</bool>
    <integer-array name="config_autoBrightnessLevels">
        <item>8</item>
        <item>15</item>
        <item>30</item>
        <item>50</item>
        <item>70</item>
        <item>100</item>
        <item>200</item>
        <item>300</item>
        <item>500</item>
        <item>700</item>
        <item>1000</item>
        <item>2000</item>
        <item>3000</item>
        <item>4000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>7</item>
        <item>34</item>
        <item>50</item>
        <item>70</item>
        <item>73</item>
        <item>75</item>
        <item>78</item>
        <item>81</item>
        <item>85</item>
        <item>95</item>
        <item>108</item>
        <item>129</item>
        <item>194</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- Fingerprint: stock HIDL 2.1 HAL, sensor 0, strong (BIOMETRIC_STRONG = 15) -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>

    <!-- Audio -->
    <bool name="config_supportAudioSourceUnprocessed">false</bool>

    <!-- Memory: Android 17 defaults to 1024 cached processes and leaves all
         trimming to lmkd. On 3.6 GB with GMS that kept memory PSI near 60%
         ("some" avg10) and lmkd killed eight apps in five seconds. One UI caps
         hidden apps at 12-20 (ro.slmk.dha_*), which AOSP lmkd ignores. -->
    <integer name="config_customizedMaxCachedProcesses">24</integer>

    <!-- Sound dose (CSD), behind Settings > Sound > hearing health: the stock
         Android 11 audio HAL has no ISoundDose, so audioserver computes the
         MEL values itself on the mixer threads (MelReporter falls back to the
         framework MEL processor). Offloaded playback is not measured. -->
    <bool name="config_safe_sound_dosage_enabled">true</bool>
</resources>
