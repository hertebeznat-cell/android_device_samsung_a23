<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Qualcomm WCN3950: 802.11ac, no 6 GHz / 802.11ax. -->
    <bool name="config_wifiSoftap5ghzSupported">true</bool>
    <bool name="config_wifiSoftapIeee80211axSupported">false</bool>
    <bool name="config_wifi_softap_sae_supported">false</bool>
    <!-- Changing the STA MAC makes the stock Samsung/QCOM HAL restart the
         adapter (hdd_start_station_adapter). Android 17 starts a user-selected
         connection twice (save + connect), and the second MAC change tore the
         first association down, so the setup wizard never connected (Settings
         only worked through its auto-retry). Keep the factory MAC. -->
    <bool name="config_wifi_connected_mac_randomization_supported">false</bool>
    <bool name="config_wifi_p2p_mac_randomization_supported">true</bool>
</resources>
