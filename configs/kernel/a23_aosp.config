# SPDX-License-Identifier: GPL-2.0-only
# Applied after blxyzY a23_eur_open_defconfig, pinned in source-lock.json.
# This is an AOSP bring-up configuration, not a claim of tested bootability.
CONFIG_LOCALVERSION="-a23-evox"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CMDLINE=""
CONFIG_CMDLINE_EXTEND=y
# CONFIG_CMDLINE_FORCE is not set

# Android userspace memory/process accounting and network BPF.
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
# CONFIG_SIMPLE_LMK is not set
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Keep SELinux enforcement; do not depend on Samsung proprietary hypervisor
# protection interfaces in an AOSP kernel. Unknown removed symbols are benign.
# CONFIG_UH is not set
# CONFIG_RKP is not set
# CONFIG_KDP is not set
# CONFIG_KDP_CRED is not set
# CONFIG_KDP_NS is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_SECURITY_DEFEX_USER is not set
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY="selinux"
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Built-in WLAN must not be mixed with the stock 4.19.157 .ko files.
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="default"

# Preserve evidence across an unsuccessful first boot.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SEC_LOG_LAST_KMSG=y
