# Applied after a23_eur_open_defconfig from blxyzY/android_kernel_samsung_sm6225.
# Everything Android needs (FAKE_UNAME_5_10, BPF backports, USERFAULTFD,
# BINDERFS, PSI, inline encryption) is already enabled by the base defconfig.
CONFIG_LOCALVERSION="-a23-evox"

# KernelSU stays as in the proven release config: SUSFS (fs/Kconfig) does not
# depend on KSU but calls into it, so KSU=n alone breaks the build. Without
# its manager app KernelSU grants nothing.

# Keep evidence of failed boots.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
