 // distributed under the License is distributed on an "AS IS" BASIS,
 // WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
 // See the License for the specific language governing permissions and
 // limitations under the License.
 
 package {
     default_team: "trendy_team_platform_security",
     // See: http://go/android-license-faq
     default_applicable_licenses: ["Android-Apache-2.0"],
 }
 
 sh_test_host {
     name: "seamendc-test",
     src: "seamendc-test.sh",
     data_bins: [
         "seamendc",
         "secilc",
         "searchpolicy",
     ],
     data: [
         ":sepolicy-cil-files",
     ],
 }
 
 filegroup {
     name: "sepolicy-cil-files",
-    device_first_srcs: [
-        ":plat_sepolicy.cil",
-        ":plat_pub_versioned.cil",
-        ":system_ext_sepolicy.cil",
-        ":product_sepolicy.cil",
-        ":vendor_sepolicy.cil",
-        ":odm_sepolicy.cil",
-    ],
+    // Stock vendor products have no generated ODM policy. Reuse the exact
+    // inputs of the rebuilt policy, including its legacy compatibility maps.
+    srcs: select(soong_config_variable("a23", "use_stock_vendor_policy"), {
+        true: [":a23_cts_combined_sepolicy.cil"],
+        default: [],
+    }),
+    device_first_srcs: select(soong_config_variable("a23", "use_stock_vendor_policy"), {
+        true: [],
+        default: [
+            ":plat_sepolicy.cil",
+            ":plat_pub_versioned.cil",
+            ":system_ext_sepolicy.cil",
+            ":product_sepolicy.cil",
+            ":vendor_sepolicy.cil",
+            ":odm_sepolicy.cil",
+        ],
+    }),
 }
+
+genrule {
+    name: "a23_cts_combined_sepolicy.cil",
+    srcs: [":precompiled_sepolicy_srcs"],
+    out: ["a23-combined-sepolicy.cil"],
+    cmd: "cat $(in) > $(out)",
+}
diff --git a/tools/selinux/seamendc-test.sh b/tools/selinux/seamendc-test.sh
--- a/tools/selinux/seamendc-test.sh
+++ b/tools/selinux/seamendc-test.sh
@@ -1,50 +1,55 @@
 #!/bin/bash
 set -e
 
 # Generate the amend policy in cil format.
 echo "(type foo)" > test_sepolicy.cil
 echo "(typeattribute bar)" >> test_sepolicy.cil
 echo "(typeattributeset bar (foo))" >> test_sepolicy.cil
 echo "(allow foo bar (file (read)))" >> test_sepolicy.cil
 
 # Generate the definitions file containing (re)definitions of existing types/classes/attributes, and
 # of preliminary symbols. This file is needed by seamendc to successfully parse the CIL policy.
 echo "(sid test)" > definitions.cil
 echo "(sidorder (test))" >> definitions.cil
 echo "(class file (read))" >> definitions.cil
 echo "(classorder (file))" >> definitions.cil
 
+# Use the same full policy inputs as the stock-vendor binary build. A single
+# combined CIL preserves identically named mapping files from different partitions.
+if [[ -f a23-combined-sepolicy.cil ]]; then
+  policy_files=(a23-combined-sepolicy.cil)
+else
+  policy_files=(
+    plat_sepolicy.cil
+    plat_pub_versioned.cil
+    system_ext_sepolicy.cil
+    product_sepolicy.cil
+    vendor_sepolicy.cil
+    odm_sepolicy.cil
+  )
+fi
+
 # Compile binary and amend policies using secilc.
 ./secilc -m -M true -G -N -c 30 \
   -o sepolicy+test-secilc.binary \
-  plat_sepolicy.cil \
-  plat_pub_versioned.cil \
-  system_ext_sepolicy.cil \
-  product_sepolicy.cil \
-  vendor_sepolicy.cil \
-  odm_sepolicy.cil \
+  "${policy_files[@]}" \
   test_sepolicy.cil
 
 # Compile binary policy and use seamendc to amend the binary file.
 ./secilc -m -M true -G -N -c 30 \
   -o sepolicy.binary \
-  plat_sepolicy.cil \
-  plat_pub_versioned.cil \
-  system_ext_sepolicy.cil \
-  product_sepolicy.cil \
-  vendor_sepolicy.cil \
-  odm_sepolicy.cil
+  "${policy_files[@]}"
 
 ./seamendc -vv \
   -o sepolicy+test-seamendc.binary \
   -b sepolicy.binary \
   test_sepolicy.cil definitions.cil
 
 # Diff the generated binary policies.
 ./searchpolicy --allow sepolicy+test-secilc.binary -s foo > secilc.diff
 ./searchpolicy --allow sepolicy+test-seamendc.binary -s foo > seamendc.diff
 diff secilc.diff seamendc.diff
 
 ./searchpolicy --allow sepolicy+test-secilc.binary -t foo > secilc.diff
 ./searchpolicy --allow sepolicy+test-seamendc.binary -t foo > seamendc.diff
 diff secilc.diff seamendc.diff
