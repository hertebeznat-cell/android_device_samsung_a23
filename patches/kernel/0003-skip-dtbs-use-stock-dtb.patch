+#subdir-y += samsung
 subdir-y += socionext
 subdir-y += sprd
 subdir-y += synaptics
@@ -33,7 +36,7 @@ dtstree		:= $(srctree)/$(src)
 
 # Qualcomm khaje (SM6225) base DTS/overlay tree
 ifneq ($(wildcard $(dtstree)/vendor/Makefile),)
-subdir-y += vendor
+#subdir-y += vendor
 endif
 
 dtb-$(CONFIG_OF_ALL_DTBS) := $(patsubst $(dtstree)/%.dts,%.dtb, $(foreach d,$(subdir), $(wildcard $(dtstree)/$(d)/*.dts)))
